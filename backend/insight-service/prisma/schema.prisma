generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("INSIGHT_DATABASE_URL")
}

model ServiceMetadata {
  key       String   @id @map("metadata_key") @db.VarChar(100)
  value     String   @map("metadata_value")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("service_metadata")
}

// Dấu vết tra cứu, không phải sách hoặc snapshot nội dung của provider.
model MetadataLookup {
  id        String   @id @default(uuid()) @db.Uuid
  ownerId   String   @map("owner_id") @db.Uuid
  isbn13    String   @db.VarChar(13)
  attempts  Json
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([ownerId, createdAt, id])
  @@index([ownerId, isbn13])
  @@map("metadata_lookups")
}

model ConsumedCirculationEvent {
  eventId    String   @id @map("event_id") @db.Uuid
  digest     String   @db.Char(64)
  receivedAt DateTime @default(now()) @map("received_at") @db.Timestamptz(6)

  @@map("consumed_circulation_events")
}

// Thông báo trạng thái mới nhất theo giao dịch; không chứa tên/email hoặc snapshot Catalog.
model CirculationNotice {
  aggregateType    String   @map("aggregate_type") @db.VarChar(8)
  aggregateId      String   @map("aggregate_id") @db.Uuid
  aggregateVersion BigInt   @map("aggregate_version")
  eventId          String   @unique @map("event_id") @db.Uuid
  eventType        String   @map("event_type") @db.VarChar(40)
  readerId         String   @map("reader_id") @db.Uuid
  occurredAt       DateTime @map("occurred_at") @db.Timestamptz(6)
  receivedAt       DateTime @default(now()) @map("received_at") @db.Timestamptz(6)
  dueAt            DateTime? @map("due_at") @db.Timestamptz(6)
  expiresAt        DateTime? @map("expires_at") @db.Timestamptz(6)

  @@id([aggregateType, aggregateId])
  @@index([readerId, occurredAt, aggregateId])
  @@map("circulation_notices")
}

// Mỗi event hợp lệ tạo tối đa một mục hộp thư; chỉ giữ mã giao dịch và thời điểm.
model ReaderNotification {
  id               String    @id @db.Uuid
  readerId         String    @map("reader_id") @db.Uuid
  aggregateType    String    @map("aggregate_type") @db.VarChar(8)
  aggregateId      String    @map("aggregate_id") @db.Uuid
  aggregateVersion BigInt    @map("aggregate_version")
  eventType        String    @map("event_type") @db.VarChar(40)
  occurredAt       DateTime  @map("occurred_at") @db.Timestamptz(6)
  receivedAt       DateTime  @default(now()) @map("received_at") @db.Timestamptz(6)
  expiresAt        DateTime? @map("expires_at") @db.Timestamptz(6)
  readAt           DateTime? @map("read_at") @db.Timestamptz(6)

  @@index([readerId, receivedAt(sort: Desc), id(sort: Desc)], map: "reader_notifications_reader_received_idx")
  @@map("reader_notifications")
}

// Kết quả phân tích đã chốt; các số liệu chỉ là bằng chứng dẫn xuất từ Core.
model AcquisitionRecommendation {
  id                    String   @id @default(uuid()) @db.Uuid
  bookId                String   @map("book_id") @db.Uuid
  branchId              String   @map("branch_id") @db.Uuid
  windowFrom            DateTime @map("window_from") @db.Timestamptz(6)
  windowTo              DateTime @map("window_to") @db.Timestamptz(6)
  snapshotAt            DateTime @map("snapshot_at") @db.Timestamptz(6)
  sourceContractVersion String   @map("source_contract_version") @db.VarChar(40)
  sourceRevision        String   @map("source_revision") @db.VarChar(255)
  scoreVersion          String   @map("score_version") @db.VarChar(40)
  score                 Decimal  @db.Decimal(5, 1)
  confidence            Decimal  @db.Decimal(3, 2)
  evidence              Json     @db.JsonB
  state                 String   @default("DRAFT") @db.VarChar(8)
  version               Int      @default(0)
  createdBy             String   @map("created_by") @db.Uuid
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  reviewedBy            String?  @map("reviewed_by") @db.Uuid
  reviewedAt            DateTime? @map("reviewed_at") @db.Timestamptz(6)
  reviewReason          String?  @map("review_reason") @db.VarChar(1000)
  decisions             AcquisitionDecision[]

  @@unique([bookId, branchId, windowFrom, windowTo, snapshotAt, sourceContractVersion, sourceRevision, scoreVersion], map: "uq_acquisition_source_snapshot")
  @@index([state, createdAt, id], map: "ix_acquisition_recommendations_state_created")
  @@index([bookId, branchId, createdAt, id], map: "ix_acquisition_recommendations_scope_created")
  @@map("acquisition_recommendations")
}

model AcquisitionDecision {
  id               String   @id @default(uuid()) @db.Uuid
  recommendationId String   @map("recommendation_id") @db.Uuid
  recommendation   AcquisitionRecommendation @relation(fields: [recommendationId], references: [id], onDelete: Restrict)
  action           String   @db.VarChar(8)
  actorId          String   @map("actor_id") @db.Uuid
  reason           String   @db.VarChar(1000)
  version          Int
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([recommendationId, version], map: "uq_acquisition_decision_version")
  @@index([recommendationId, createdAt, id], map: "ix_acquisition_decisions_created")
  @@map("acquisition_decisions")
}
