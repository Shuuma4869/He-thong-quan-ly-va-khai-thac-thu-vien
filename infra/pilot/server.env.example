# Documentation only: configure these in the provider secret/environment settings.
SPRING_PROFILES_ACTIVE=pilot
PORT=8080
# Direct (not pooled) Neon endpoint for Flyway + pilot pool; no password in JDBC URL.
CORE_DATABASE_URL=jdbc:postgresql://YOUR-NEON-HOST/lams_core?sslmode=verify-full&sslfactory=org.postgresql.ssl.DefaultJavaSSLFactory
CORE_DATABASE_USERNAME=
CORE_DATABASE_PASSWORD=
LAMS_JWT_SECRET=
# Exact HTTPS origins; include the deployed web frontend only when it exists.
CORS_ALLOWED_ORIGINS=https://tauri.localhost
