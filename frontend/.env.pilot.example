# Public build configuration only; no credentials or tokens.
# Copy to .env.pilot.local and replace the hostname after the pilot is deployed.
VITE_DEPLOYMENT_ENV=pilot
VITE_CORE_API_URL=https://YOUR-CORE-HOST/api/v1
# Set only when Insight is actually deployed; never fallback to an end user's localhost.
VITE_INSIGHT_API_URL=
VITE_API_TIMEOUT_MS=15000
