{
  "name": "lams-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22 <23",
    "npm": ">=10 <11"
  },
  "scripts": {
    "dev": "vite",
    "desktop:dev": "tauri dev",
    "desktop:build": "node scripts/build-desktop.mjs",
    "build:desktop": "npm run typecheck && vite build --mode desktop",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json",
    "build": "npm run typecheck && vite build",
    "test": "node --test scripts/*.test.mjs && vitest run",
    "test:e2e": "playwright test",
    "test:watch": "vitest",
    "lint": "eslint ."
  },
  "dependencies": {
    "@hookform/resolvers": "5.2.2",
    "@tanstack/react-query": "5.90.2",
    "bootstrap": "5.3.8",
    "lucide-react": "0.544.0",
    "react": "19.1.1",
    "react-bootstrap": "2.10.10",
    "react-dom": "19.1.1",
    "react-hook-form": "7.63.0",
    "react-router-dom": "7.18.4",
    "zod": "4.1.11"
  },
  "devDependencies": {
    "@eslint/js": "9.36.0",
    "@playwright/test": "1.64.0",
    "@tailwindcss/vite": "4.1.14",
    "@tauri-apps/cli": "2.12.2",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "24.6.0",
    "@types/react": "19.1.16",
    "@types/react-dom": "19.1.9",
    "@vitejs/plugin-react": "5.0.4",
    "eslint": "9.36.0",
    "eslint-plugin-react-hooks": "5.2.0",
    "eslint-plugin-react-refresh": "0.4.22",
    "globals": "16.4.0",
    "jsdom": "27.0.0",
    "tailwindcss": "4.1.14",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "vite": "7.3.7",
    "vitest": "5.0.4"
  }
}
